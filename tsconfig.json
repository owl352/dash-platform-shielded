{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./pkg",
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "sourceMap": false,
    "strict": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": false
  },
  "include": ["pkg/**/*"]
}
