{
  "name": "dash-platform-shielded",
  "version": "0.0.0",
  "description": "Shielded (Orchard/Halo 2) module for dash-platform-sdk: proving, Orchard wrappers, and shielded-pool verification",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./lazy": {
      "types": "./dist/src/lazy.d.ts",
      "default": "./dist/src/lazy.js"
    },
    "./bindingsTypes": {
      "types": "./dist/binaries/bindingsTypes.d.ts"
    },
    "./wrappers": {
      "types": "./dist/src/wrappers.d.ts",
      "default": "./dist/src/wrappers.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node build.cjs && npm run build:ts && npm run build:dist",
    "build:dist": "node -e \"const fs=require('fs');fs.rmSync('dist/src',{recursive:true,force:true});fs.cpSync('js/src','dist/src',{recursive:true});fs.cpSync('js/binaries','dist/binaries',{recursive:true})\"",
    "build:typings": "node utils/genTypings.mjs",
    "test": "node test/standalone.test.mjs && node test/utility-parity.test.mjs",
    "build:ts": "node -e \"require('fs').rmSync('dist/ts',{recursive:true,force:true})\" && tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owl352/dash-platform-shielded.git"
  },
  "author": "owl352",
  "license": "ISC",
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@tybys/wasm-util": "^0.10.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.4",
    "emnapi": "1.11.3",
    "wasm-opt": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
